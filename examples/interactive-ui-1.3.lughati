# مثال عملي: ربط الأزرار والحقول بدوال لُغتي 1.3
دع العدد = 0
دع الاسم = "زائر"

دالة اعرض_الحالة() {
    اعرض_واجهة({
        عنوان: "مرحباً " + الاسم,
        خلفية: "#edf4fb",
        لون_النص: "#183153",
        عناصر: [
            {نوع: "عنوان", نص: "لوحة تفاعلية"},
            {نوع: "نص", نص: "عدد النقرات: " + نص(العدد)},
            {نوع: "حقل", اسم: "الاسم", تلميح: "اكتب اسمك", قيمة: الاسم, عند_التغيير: غيّر_الاسم},
            {نوع: "زر", نص: "زيادة العدد", عند_الضغط: زد},
            {نوع: "بطاقة", نص: "تتغير هذه الواجهة وفق بيانات البرنامج."}
        ]
    })
}

دالة زد() {
    العدد = العدد + 1
    اعرض_الحالة()
}

دالة غيّر_الاسم(القيمة) {
    الاسم = القيمة
    اعرض_الحالة()
}

اعرض_الحالة()
